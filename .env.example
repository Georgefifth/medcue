# Copy to .env, fill GEMINI_API_KEY, and restart. Never prefix a secret with VITE_.
GEMINI_API_KEY=

AI_PROVIDER=cloud
AI_PROVIDER_NAME=Google Gemini
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash-lite
AI_JSON_MODE=true

# Conservative APPLICATION caps, not a statement of Google's project quota.
# Google AI Studio is authoritative; other apps share the same project quota.
AI_MAX_REQUESTS_PER_MINUTE=4
AI_MIN_REQUEST_INTERVAL_MS=15000
AI_MAX_CONCURRENT_REQUESTS=1
AI_MAX_REQUESTS_PER_HOUR=20
AI_MAX_REQUESTS_PER_DAY=20
AI_MAX_INPUT_TOKENS_PER_MINUTE=20000
AI_QUOTA_TIMEZONE=America/Los_Angeles

PORT=8080
HOST=127.0.0.1
